  rootNode:
    dialogueText: "Hej, nazywam sie D\u017Cordz Flojd. Nie moge oddychac"
    responses:
    - responseText: Chuj mnie to niggusie. Zastrzele cie
      nextNode:
        dialogueText: Nie. Ja nie jestem czarny
        responses:
        - responseText: Jak kurwa nie umieraj
          nextNode:
            dialogueText: 
            responses: []
        - responseText: Okej. oszczedze cie
          nextNode:
            dialogueText: 
            responses: []
    - responseText: WOOOO KOCHAM CIE
      nextNode:
        dialogueText: Ja ciebie nie krzaku
        responses:
        - responseText: no kurwa mac
